# Postgres connection string (Vercel Postgres / Neon — use the POOLED url)
DATABASE_URL=

# Password for the single admin login on /login
DASHBOARD_PASSWORD=

# Bearer token required by every /api/cron/* route.
# Vercel Cron sends this automatically once the env var is set on the project.
CRON_SECRET=

# 32-byte base64 key used for AES-256-GCM encryption of store API tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
